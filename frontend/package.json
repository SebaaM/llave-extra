{
  "name": "llave-extra-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty",
    "test:proxy": "node --test tests/proxy-config.test.mjs",
    "test": "pnpm run test:proxy && vitest run && node --experimental-strip-types --test src/prototypes/*.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.2.0",
    "vite": "7.3.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.3",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.4.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "30.1.3",
    "vitest": "5.0.5"
  }
}
